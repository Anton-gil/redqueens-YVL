# Base mainnet RPC. The real-contract Multipli recon (agent/multipli_target.py) defaults to the
# public keyless endpoint below and needs no key. A dedicated Alchemy/Infura key is only needed for
# heavy `forge test --fork-url` work.
BASE_RPC_URL=https://mainnet.base.org

# Base verified-source explorer API (keyless). Used by the real Multipli recon to pull verified
# source and resolve proxy implementations.
BASE_BLOCKSCOUT_API=https://base.blockscout.com/api

# Pin the fork so every run/demo is reproducible against the same state.
FORK_BLOCK_NUMBER=20000000

# Claude API key for the attack agent (tool-use loop). Without this, the orchestrator falls
# back to a deterministic playbook-template agent (see agent/attacker.py: FallbackAgent).
ANTHROPIC_API_KEY=

# Attack-agent cost guard: hard stop for the whole run, in USD, checked after every LLM call.
RED_QUEEN_BUDGET_USD=2.00

# Real Multipli deployment addresses on Base, comma-separated, for the advisory-only run.
# Leave blank to use the built-in verified defaults in agent/multipli_target.py (rwaUSD token proxy
# + CCIP bridge pool, sourced from docs.multipli.fi). Set this to override the target set.
MULTIPLI_TARGET_ADDRESSES=0x272Ec977f4575df41cD47b1b254954E1C7972789,0x7Dc0496016d88c3EbA6d54D1514F24B3C9872894
